{
  "name": "kafka-pubsub-orders",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest --runInBand",
    "dev:order": "tsx watch apps/order-service/src/main.ts",
    "dev:inventory": "tsx watch apps/inventory-service/src/main.ts",
    "dev:notification": "tsx watch apps/notification-service/src/main.ts",
    "start:order": "node dist/apps/order-service/src/main.js",
    "start:inventory": "node dist/apps/inventory-service/src/main.js",
    "start:notification": "node dist/apps/notification-service/src/main.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "kafkajs": "^2.2.4",
    "pino": "^9.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.10",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.3",
    "tsx": "^4.20.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3"
  }
}
